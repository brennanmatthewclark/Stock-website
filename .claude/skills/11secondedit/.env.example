# Copy to .env at your project root (or next to SKILL.md). Never commit the real file.
AUPHONIC_API_KEY=
ELEVENLABS_API_KEY=

# Optional WhisperX tuning
# WHISPERX_MODEL=small.en        # base.en (fast) · small.en · medium.en · large-v3 (multilingual)
# WHISPERX_DEVICE=cpu            # cuda on NVIDIA GPUs
# WHISPERX_COMPUTE_TYPE=int8
# WHISPERX_LANGUAGE=en

# Optional: where projects are stored (default ./11secondedit-projects)
# ELEVEN_SECOND_EDIT_HOME=
